  {"number": 133, "lines": [[678, 679, 680], [681, 682, 683]], "text": ["भाषारूपा बृहत्सेना भावाभावविवर्जिता ।", "सुखाराध्या शुभकरी शोभना सुलभा गतिः ॥ 133 ॥"]},
  {"number": 134, "lines": [[684, 685, 686], [687, 688]], "text": ["राजराजेश्वरी राज्यदायिनी राज्यवल्लभा ।", "राजत्कृपा राजपीठनिवेशितनिजाश्रिता ॥ 134 ॥"]},
  {"number": 135, "lines": [[689, 690, 691], [692, 693, 694]], "text": ["राज्यलक्ष्मीः कोशनाथा चतुरङ्गबलेश्वरी ।", "साम्राज्यदायिनी सत्यसन्धा सागरमेखला ॥ 135 ॥"]},
