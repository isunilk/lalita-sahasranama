[
  {"number": 1, "lines": [[1, 2, 3], [4, 5]], "text": ["श्रीमाता श्रीमहाराज्ञी श्रीमत्सिंहासनेश्वरी ।", "चिदग्निकुण्डसम्भूता देवकार्यसमुद्यता ॥ 1 ॥"]},
  {"number": 2, "lines": [[6, 7], [8, 9]], "text": ["उद्यद्भानुसहस्राभा चतुर्बाहुसमन्विता ।", "रागस्वरूपपाशाढ्या क्रोधाकाराङ्कुशोज्ज्वला ॥ 2 ॥"]},
