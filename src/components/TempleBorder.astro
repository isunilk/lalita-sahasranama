---
const { id = 'temple-border' } = Astro.props;
---
<svg class="temple-border" aria-hidden="true" width="100%" height="20">
  <defs>
    <pattern id={id} width="32" height="20" patternUnits="userSpaceOnUse">
      <path d="M0 20C6 20 8 6 16 4C24 6 26 20 32 20" fill="none" stroke="#E9BE5C" stroke-width="1.3" />
      <circle cx="16" cy="12" r="1.8" fill="#E9BE5C" />
    </pattern>
  </defs>
  <rect width="100%" height="20" fill={`url(#${id})`} />
</svg>
