---
import '../styles/fonts.css';
import '../styles/global.css';
// The two fonts nearly every page shows first; preloading them saves a round trip after the CSS arrives.
import devanagariFont from '@fontsource/tiro-devanagari-sanskrit/files/tiro-devanagari-sanskrit-devanagari-400-normal.woff2?url';
import textFont from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site.mjs';
import { t } from '../i18n/ui.mjs';

const { lang = 'en', title, description, path, alternates = [], jsonLd = null, pageData = null, hasLanguageButtons = true } = Astro.props;
const abs = (p) => new URL(p, SITE.origin).href;
const canonical = abs(path);
const xDefault = alternates.find((a) => a.lang === 'en') || alternates[0];
const ogLocale = { en: 'en_IN', hi: 'hi_IN' }[lang] || 'en_IN';
const safeJson = (v) => JSON.stringify(v).replace(/</g, '\\u003c');
const shareImage = abs('/og-image.jpg');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.href)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault.href)} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lalitā Sahasranāma (ललितासहस्रनाम): the thousand names of the Divine Mother" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#7A1712" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={devanagariFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={safeJson(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skip')}</a>
    <Header lang={lang} hasLanguageButtons={hasLanguageButtons} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {pageData && <script type="application/json" id="page-data" set:html={safeJson(pageData)} />}
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
